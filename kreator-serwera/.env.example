# ─────────────────────────────────────────────────────────────
#  Kreator Serwera – konfiguracja
#  Skopiuj ten plik jako ".env" i uzupełnij DISCORD_TOKEN.
# ─────────────────────────────────────────────────────────────

# Token bota z Discord Developer Portal (zakładka Bot → Reset Token).
# NIGDY nikomu go nie pokazuj i nie wrzucaj do internetu!
DISCORD_TOKEN=TWOJ_TOKEN_BOTA

# (opcjonalnie) ID serwera testowego – komenda /stworz pojawi się na nim natychmiast.
# Zostaw puste, aby komenda była dostępna na wszystkich serwerach z botem.
DEV_GUILD_ID=

# (opcjonalnie) Po ilu minutach bezczynności wygasa panel kreatora (5–120, domyślnie 30).
SESSION_TIMEOUT_MIN=30

# (opcjonalnie) true = kreatora może używać tylko właściciel serwera
# (domyślnie: każdy z uprawnieniem Administrator).
OWNER_ONLY=false

# Kody dostępu: /stworz działa dopiero po wpisaniu kodu, który generujesz w konsoli bota
# komendą „kod” (na Wispbyte: pole pod konsolą). /usun działa zawsze, bez kodu.
# false = /stworz bez kodu (np. do testów na własnym serwerze).
REQUIRE_CODE=true

# (opcjonalnie) Gdzie zapisywać kody (domyślnie data/kody.json w folderze bota).
# Nie usuwaj tego pliku przy aktualizacji bota – są w nim sprzedane kody!
CODES_FILE=

# (opcjonalnie) ID sprzedawców (Twoje ID Discord, po przecinku). Sprzedawca używa /stworz bez kodu,
# ma wszystkie funkcje i może zapisywać szablony. Puste = właściciel aplikacji bota z Developer Portal.
SELLER_IDS=

# (opcjonalnie) Powiadomienia o użyciu kodów i budowach na Twoim Discordzie:
# webhook kanału (Ustawienia kanału → Integracje → Webhooki → Kopiuj URL) …
NOTIFY_WEBHOOK_URL=
# … albo ID kanału na serwerze, na którym jest bot.
NOTIFY_CHANNEL_ID=

# (opcjonalnie) Poziom logów w konsoli: debug | info | warn | error
LOG_LEVEL=info

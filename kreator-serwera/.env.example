# ─────────────────────────────────────────────────────────────
#  Kreator Serwera – konfiguracja
#  Skopiuj ten plik jako ".env" i uzupełnij DISCORD_TOKEN.
# ─────────────────────────────────────────────────────────────

# Token bota z Discord Developer Portal (zakładka Bot → Reset Token).
# NIGDY nikomu go nie pokazuj i nie wrzucaj do internetu!
DISCORD_TOKEN=TWOJ_TOKEN_BOTA

# (opcjonalnie) ID serwera testowego – komenda /stworz pojawi się na nim natychmiast.
# Zostaw puste, aby komenda była dostępna na wszystkich serwerach z botem.
DEV_GUILD_ID=

# (opcjonalnie) Po ilu minutach bezczynności wygasa panel kreatora (5–120, domyślnie 30).
SESSION_TIMEOUT_MIN=30

# (opcjonalnie) true = kreatora może używać tylko właściciel serwera
# (domyślnie: każdy z uprawnieniem Administrator).
OWNER_ONLY=false

# (opcjonalnie) Poziom logów w konsoli: debug | info | warn | error
LOG_LEVEL=info

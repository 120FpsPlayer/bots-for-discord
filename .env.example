# ═══════════════════════════ BOT ═══════════════════════════
# Token bota z https://discord.com/developers/applications
DISCORD_TOKEN=
# Application ID (Client ID) bota
CLIENT_ID=
# (opcjonalnie) ID serwera – komendy zarejestrują się natychmiast tylko na nim.
# Zostaw puste, aby zarejestrować komendy globalnie (propagacja do ~1h).
GUILD_ID=

# ═══════════════════════ UPRAWNIENIA ═══════════════════════
# W KAŻDYM polu możesz wpisać DOWOLNIE DUŻO ról – oddziel je przecinkami:
#   SUPPORT_ROLE_IDS=111111111111111111,222222222222222222,333333333333333333
# Spacje, średniki, cudzysłowy i skopiowane wzmianki <@&123…> też działają.
# Działa również nazwa w liczbie pojedynczej (np. SUPPORT_ROLE_ID) – obie się sumują.
# Po starcie bot wypisze w konsoli, które role wczytał i których nie ma na serwerze.
#
# ID skopiujesz po włączeniu Trybu dewelopera (Ustawienia → Zaawansowane)
# i kliknięciu PPM na użytkownika/rolę → „Kopiuj ID".

# 👑 Właściciele bota (ID UŻYTKOWNIKÓW) – pełny dostęp do wszystkiego
OWNER_IDS=

# 🛡️ Role administratorów bota – /setup, /panel, /blacklist, usuwanie ticketów,
# nadpisywanie przejęć. Widzą wszystkie tickety.
ADMIN_ROLE_IDS=

# 🎧 Role supportu – widzą i obsługują tickety (przejmowanie, zamykanie, dodawanie osób…)
# np. Helper, Moderator, Support, Starszy Support:
# SUPPORT_ROLE_IDS=111111111111111111,222222222222222222,333333333333333333,444444444444444444
SUPPORT_ROLE_IDS=

# 🎧 Dodatkowe role supportu tylko dla konkretnej kategorii ticketu
# (nazwa = SUPPORT_ROLE_IDS_ + id typu z config.json wielkimi literami)
# SUPPORT_ROLE_IDS_REPORT=
# SUPPORT_ROLE_IDS_PARTNERSHIP=
# SUPPORT_ROLE_IDS_APPEAL=

# ✅ Kto może otwierać tickety – puste = wszyscy
# np. rola „Zweryfikowany", żeby nowe konta nie spamowały ticketami
OPEN_ROLE_IDS=

# ⛔ Role, które NIE mogą otwierać ticketów (np. „Wyciszony")
BLOCKED_ROLE_IDS=

# Czy osoby z uprawnieniem Discorda „Administrator"/„Zarządzanie serwerem"
# są automatycznie adminami bota (true/false)
DISCORD_ADMINS_ARE_ADMINS=true

# Czy support może usuwać tickety (false = tylko admini)
STAFF_CAN_DELETE=true

# Czy autor ticketu może sam go zamknąć
OWNER_CAN_CLOSE=true

# ═════════════════════ KANAŁY (opcjonalne) ═════════════════════
# Możesz je ustawić tutaj ALBO komendą /setup (ustawienia z /setup mają pierwszeństwo)
TICKET_CATEGORY_ID=
CLOSED_CATEGORY_ID=
LOG_CHANNEL_ID=
TRANSCRIPT_CHANNEL_ID=

# ═══════════════════════ INNE ═══════════════════════
# Bot sam rejestruje komendy slash przy starcie (nie trzeba „npm run deploy")
AUTO_DEPLOY_COMMANDS=true
